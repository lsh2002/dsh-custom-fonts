{
  "name": "dsh-custom-fonts",
  "version": "1.1.0",
  "description": "Customize the DeepSeek Harness UI's Chinese and English fonts, code font, and global font-size offset on a settings page with a live preview — 在设置页自定义界面中英文/代码字体与全局字号偏移，实时预览、全局生效。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "font",
    "fonts",
    "font-size",
    "code font",
    "chinese",
    "english",
    "ui",
    "等宽",
    "代码字体",
    "字体",
    "中文字体",
    "英文字体",
    "字号"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsh2002/dsh-custom-fonts.git"
  },
  "homepage": "https://github.com/lsh2002/dsh-custom-fonts",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
